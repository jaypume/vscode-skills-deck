{
  "name": "skills-manager",
  "displayName": "Skills Manager — Declarative Agent Skills",
  "description": "Declaratively manage AI agent skills: declare what you want, reconcile against what's installed, sync to/from disk. Works across Claude Code, Cursor, Windsurf, Copilot, Codex, and more.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "pujie",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "agent skills",
    "skills",
    "claude code",
    "cursor",
    "copilot",
    "windsurf",
    "codex",
    "skills.sh",
    "declarative",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jaypume/vscode-skills-manager"
  },
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillsManager",
          "title": "Skills Manager",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "skillsManager": [
        {
          "id": "skillsManager.view",
          "name": "Skills"
        },
        {
          "id": "skillsManager.details",
          "name": "Details"
        }
      ]
    },
    "commands": [
      {
        "command": "skillsManager.addSkill",
        "title": "Add Skill",
        "category": "Skills Manager",
        "icon": "$(add)"
      },
      {
        "command": "skillsManager.removeSkill",
        "title": "Remove from List",
        "category": "Skills Manager",
        "icon": "$(close)"
      },
      {
        "command": "skillsManager.removeRepository",
        "title": "Delete Repository and Skills",
        "category": "Skills Manager",
        "icon": "$(trash)"
      },
      {
        "command": "skillsManager.updateRepository",
        "title": "Update Repository",
        "category": "Skills Manager",
        "icon": "$(sync)"
      },
      {
        "command": "skillsManager.editSkill",
        "title": "Edit Skill",
        "category": "Skills Manager"
      },
      {
        "command": "skillsManager.refresh",
        "title": "Refresh",
        "category": "Skills Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "skillsManager.search",
        "title": "Search Skills",
        "category": "Skills Manager",
        "icon": "$(search)"
      },
      {
        "command": "skillsManager.filterStatus",
        "title": "Filter by Status",
        "category": "Skills Manager",
        "icon": "$(filter)"
      },
      {
        "command": "skillsManager.groupByCategory",
        "title": "Category (Default, custom)",
        "category": "Skills Manager",
        "icon": "$(folder)"
      },
      {
        "command": "skillsManager.groupByCategoryCurrent",
        "title": "✓ Category (Default, custom)",
        "category": "Skills Manager"
      },
      {
        "command": "skillsManager.groupBySource",
        "title": "Source (GitHub, Local, Marketplace)",
        "category": "Skills Manager",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "skillsManager.groupBySourceCurrent",
        "title": "✓ Source (GitHub, Local, Marketplace)",
        "category": "Skills Manager"
      },
      {
        "command": "skillsManager.groupByStatus",
        "title": "Status (Wanted, Unwanted, Diff)",
        "category": "Skills Manager",
        "icon": "$(circle-filled)"
      },
      {
        "command": "skillsManager.groupByStatusCurrent",
        "title": "✓ Status (Wanted, Unwanted, Diff)",
        "category": "Skills Manager"
      },
      {
        "command": "skillsManager.groupByScope",
        "title": "Scope (Global, Project)",
        "category": "Skills Manager",
        "icon": "$(root-folder)"
      },
      {
        "command": "skillsManager.groupByScopeCurrent",
        "title": "✓ Scope (Global, Project)",
        "category": "Skills Manager"
      },
      {
        "command": "skillsManager.groupByFlat",
        "title": "Flat List (No grouping)",
        "category": "Skills Manager",
        "icon": "$(list-flat)"
      },
      {
        "command": "skillsManager.groupByFlatCurrent",
        "title": "✓ Flat List (No grouping)",
        "category": "Skills Manager"
      },
      {
        "command": "skillsManager.syncToData",
        "title": "Sync to Data (Install State → List)",
        "category": "Skills Manager",
        "icon": "$(arrow-down)"
      },
      {
        "command": "skillsManager.syncFromData",
        "title": "Sync from Data (List → Install)",
        "category": "Skills Manager",
        "icon": "$(arrow-up)"
      },
      {
        "command": "skillsManager.installSelected",
        "title": "Install",
        "category": "Skills Manager",
        "icon": "$(cloud-download)"
      },
      {
        "command": "skillsManager.uninstallSelected",
        "title": "Uninstall",
        "category": "Skills Manager",
        "icon": "$(trash)"
      },
      {
        "command": "skillsManager.toggleWanted",
        "title": "Toggle Wanted / Unwanted",
        "category": "Skills Manager",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "skillsManager.inlineWanted",
        "title": "Wanted — Toggle to Unwanted",
        "category": "Skills Manager",
        "icon": "media/status-wanted.svg"
      },
      {
        "command": "skillsManager.inlineUnwanted",
        "title": "Unwanted — Toggle to Wanted",
        "category": "Skills Manager",
        "icon": "media/status-unwanted.svg"
      },
      {
        "command": "skillsManager.inlineInstalled",
        "title": "Installed — Uninstall",
        "category": "Skills Manager",
        "icon": "media/status-installed.svg"
      },
      {
        "command": "skillsManager.inlineMissing",
        "title": "Not Installed — Install",
        "category": "Skills Manager",
        "icon": "media/status-missing.svg"
      },
      {
        "command": "skillsManager.openSkillMd",
        "title": "Open SKILL.md",
        "category": "Skills Manager",
        "icon": "$(go-to-file)"
      },
      {
        "command": "skillsManager.previewSkillMd",
        "title": "Preview SKILL.md",
        "category": "Skills Manager",
        "icon": "$(eye)"
      },
      {
        "command": "skillsManager.copyPath",
        "title": "Copy Path",
        "category": "Skills Manager"
      },
      {
        "command": "skillsManager.openDataFile",
        "title": "Open data.json",
        "category": "Skills Manager",
        "icon": "$(file-code)"
      },
      {
        "command": "skillsManager.removeAllData",
        "title": "Remove All Data",
        "category": "Skills Manager"
      }
    ],
    "submenus": [
      {
        "id": "skillsManager.groupBy",
        "label": "Group By",
        "icon": "$(group-by-ref-type)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "skillsManager.removeSkill", "when": "false" },
        { "command": "skillsManager.removeRepository", "when": "false" },
        { "command": "skillsManager.updateRepository", "when": "false" },
        { "command": "skillsManager.editSkill", "when": "false" },
        { "command": "skillsManager.installSelected", "when": "false" },
        { "command": "skillsManager.uninstallSelected", "when": "false" },
        { "command": "skillsManager.toggleWanted", "when": "false" },
        { "command": "skillsManager.inlineWanted", "when": "false" },
        { "command": "skillsManager.inlineUnwanted", "when": "false" },
        { "command": "skillsManager.inlineInstalled", "when": "false" },
        { "command": "skillsManager.inlineMissing", "when": "false" },
        { "command": "skillsManager.openSkillMd", "when": "false" },
        { "command": "skillsManager.previewSkillMd", "when": "false" },
        { "command": "skillsManager.copyPath", "when": "false" },
        { "command": "skillsManager.groupByCategory", "when": "false" },
        { "command": "skillsManager.groupByCategoryCurrent", "when": "false" },
        { "command": "skillsManager.groupBySource", "when": "false" },
        { "command": "skillsManager.groupBySourceCurrent", "when": "false" },
        { "command": "skillsManager.groupByStatus", "when": "false" },
        { "command": "skillsManager.groupByStatusCurrent", "when": "false" },
        { "command": "skillsManager.groupByScope", "when": "false" },
        { "command": "skillsManager.groupByScopeCurrent", "when": "false" },
        { "command": "skillsManager.groupByFlat", "when": "false" },
        { "command": "skillsManager.groupByFlatCurrent", "when": "false" }
      ],
      "view/title": [
        { "command": "skillsManager.addSkill", "when": "view == skillsManager.view", "group": "navigation@1" },
        { "submenu": "skillsManager.groupBy", "when": "view == skillsManager.view", "group": "navigation@2" },
        { "command": "skillsManager.search", "when": "view == skillsManager.view", "group": "navigation@3" },
        { "command": "skillsManager.refresh", "when": "view == skillsManager.view", "group": "navigation@4" },
        { "command": "skillsManager.syncToData", "when": "view == skillsManager.view", "group": "sync@1" },
        { "command": "skillsManager.syncFromData", "when": "view == skillsManager.view", "group": "sync@2" },
        { "command": "skillsManager.openDataFile", "when": "view == skillsManager.view", "group": "settings@1" }
      ],
      "skillsManager.groupBy": [
        { "command": "skillsManager.groupByCategory", "when": "skillsManager.groupBy != 'category'", "group": "1_group@1" },
        { "command": "skillsManager.groupByCategoryCurrent", "when": "skillsManager.groupBy == 'category'", "group": "1_group@1" },
        { "command": "skillsManager.groupBySource", "when": "skillsManager.groupBy != 'source'", "group": "1_group@2" },
        { "command": "skillsManager.groupBySourceCurrent", "when": "skillsManager.groupBy == 'source'", "group": "1_group@2" },
        { "command": "skillsManager.groupByStatus", "when": "skillsManager.groupBy != 'status'", "group": "1_group@3" },
        { "command": "skillsManager.groupByStatusCurrent", "when": "skillsManager.groupBy == 'status'", "group": "1_group@3" },
        { "command": "skillsManager.groupByScope", "when": "skillsManager.groupBy != 'scope'", "group": "1_group@4" },
        { "command": "skillsManager.groupByScopeCurrent", "when": "skillsManager.groupBy == 'scope'", "group": "1_group@4" },
        { "command": "skillsManager.groupByFlat", "when": "skillsManager.groupBy != 'flat'", "group": "1_group@5" },
        { "command": "skillsManager.groupByFlatCurrent", "when": "skillsManager.groupBy == 'flat'", "group": "1_group@5" }
      ],
      "view/item/context": [
        { "command": "skillsManager.inlineWanted", "when": "view == skillsManager.view && viewItem =~ /\\.wanted\\./", "group": "inline@1" },
        { "command": "skillsManager.inlineUnwanted", "when": "view == skillsManager.view && viewItem =~ /\\.unwanted\\./", "group": "inline@1" },
        { "command": "skillsManager.inlineInstalled", "when": "view == skillsManager.view && viewItem =~ /\\.installed$/", "group": "inline@2" },
        { "command": "skillsManager.inlineMissing", "when": "view == skillsManager.view && viewItem =~ /\\.missing$/", "group": "inline@2" },
        { "command": "skillsManager.openSkillMd", "when": "view == skillsManager.view && viewItem =~ /Skill/", "group": "1_open@1" },
        { "command": "skillsManager.previewSkillMd", "when": "view == skillsManager.view && viewItem =~ /Skill/", "group": "1_open@2" },
        { "command": "skillsManager.editSkill", "when": "view == skillsManager.view && viewItem =~ /^declaredSkill\\./", "group": "2_edit@1" },
        { "command": "skillsManager.copyPath", "when": "view == skillsManager.view && viewItem =~ /Skill/", "group": "3_info@1" },
        { "command": "skillsManager.installSelected", "when": "view == skillsManager.view && viewItem =~ /\\.missing$/", "group": "4_manage@1" },
        { "command": "skillsManager.uninstallSelected", "when": "view == skillsManager.view && viewItem =~ /\\.installed$/", "group": "4_manage@1" },
        { "command": "skillsManager.toggleWanted", "when": "view == skillsManager.view && viewItem =~ /Skill/", "group": "4_manage@2" },
        { "command": "skillsManager.removeSkill", "when": "view == skillsManager.view && viewItem =~ /^declaredSkill\\./", "group": "4_manage@3" },
        { "command": "skillsManager.updateRepository", "when": "view == skillsManager.view && viewItem == repository", "group": "4_manage@1" },
        { "command": "skillsManager.removeRepository", "when": "view == skillsManager.view && viewItem == repository", "group": "4_manage@3" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillsManager.view",
        "contents": "No skills declared yet.\n\nDeclare what skills you want, then reconcile against what's actually installed across your AI agents (Claude Code, Cursor, Windsurf, Copilot, Codex, …).\n\n[Add Skill](command:skillsManager.addSkill)\n[Sync Installed → List](command:skillsManager.syncToData)\n[Open data.json](command:skillsManager.openDataFile)",
        "when": "skillsManager.noSkills"
      }
    ],
    "configuration": [
      {
        "title": "Skills Manager",
        "properties": {
          "skills-manager.activeAgents": {
            "type": "array",
            "default": [
              "canonical",
              "claude-code",
              "cursor",
              "windsurf",
              "github-copilot",
              "codex",
              "roo",
              "gemini-cli",
              "trae",
              "kiro",
              "continue"
            ],
            "items": {
              "type": "string",
              "enum": [
                "canonical",
                "claude-code",
                "cursor",
                "windsurf",
                "github-copilot",
                "codex",
                "roo",
                "gemini-cli",
                "trae",
                "kiro",
                "continue"
              ]
            },
            "uniqueItems": true,
            "scope": "window",
            "markdownDescription": "Which AI agents to scan for installed skills. Agent IDs: `canonical` (skills.sh), `claude-code`, `cursor`, `windsurf`, `github-copilot`, `codex`, `roo`, `gemini-cli`, `trae`, `kiro`, `continue`."
          },
          "skills-manager.defaultScope": {
            "type": "string",
            "enum": ["global", "project", "ask"],
            "enumDescriptions": [
              "Install to ~/.agents/skills/ — available everywhere",
              "Install to the current workspace",
              "Prompt each time"
            ],
            "default": "global",
            "scope": "window"
          },
          "skills-manager.confirmBeforeSync": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "markdownDescription": "Show a confirmation dialog before installing/uninstalling skills via sync."
          },
          "skills-manager.autoRefreshOnFocus": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "markdownDescription": "Re-scan skill directories when the window regains focus."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
